# Database Configuration (Required for Prisma + MongoDB)
# Use a MongoDB Atlas connection string (or any replica-set-enabled MongoDB deployment).
DATABASE_URL="mongodb+srv://user:password@cluster.mongodb.net/blockmec_db?retryWrites=true&w=majority"

# Application Configuration
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# CRITICAL SECURITY: In production, set this to your actual domain to prevent localhost URLs in generated scripts
BLOCKMEC_API_URL=https://yourdomain.com

# Script Token Security (Required)
BLOCKMEC_SCRIPT_TOKEN_SECRET=your-64-character-random-secret-change-this-in-production-generate-with-openssl-rand-64

# Blockchain Configuration
NEXT_PUBLIC_RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID
PRIVATE_KEY=0x1234567890123456789012345678901234567890123456789012345678901234
BLOCKMEC_CONTRACT_ADDRESS=0x1234567890123456789012345678901234567890

# Payment Configuration
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=PAYSTACK_PUBLIC_KEY
PAYSTACK_SECRET_KEY=PAYSTACK_SECRET_KEY
NEXT_PUBLIC_BLC_CRYPTO_WALLET_ADDRESS=BLM7F5EB5bB5cF88cfcEe9613368636f458800e62CB

# Security Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
SESSION_SECRET=your-session-secret-change-this-in-production-min-32-chars
ENCRYPTION_KEY=your-32-character-encryption-key

# Development Settings
MOCK_BLOCKCHAIN=true
DEBUG=false

# Optional: Redis
# REDIS_URL=redis://localhost:6379
# UPSTASH_REDIS_REST_URL=https://<your-upstash-db>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<your-upstash-rest-token>
# ENABLE_REDIS_RATE_LIMIT_IN_DEV=false

# Optional: Email Configuration
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Optional: AWS S3
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_S3_BUCKET=blockmec-files

# Optional: Analytics
# NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX
# SENTRY_DSN=https://your-sentry-dsn-here
