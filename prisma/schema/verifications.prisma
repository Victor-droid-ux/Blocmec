// prisma/schema/verifications.prisma
enum VerificationStatus {
  verified
  failed
  expired
  counterfeit
}

enum VerificationMethod {
  qr_scan
  api
  manual
}

model Verification {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  qr_code_id            String   @db.ObjectId
  token_id              String
  ip_address            String?
  user_agent            String?
  location_country      String?
  location_city         String?
  location_coordinates  String?
  device_type           String?
  status                VerificationStatus
  verification_method   VerificationMethod?
  metadata              Json?
  created_at            DateTime @default(now())

  qr_code QrCode @relation(fields: [qr_code_id], references: [id], onDelete: Cascade)

  @@index([qr_code_id], name: "idx_verifications_qr_code_id")
  @@index([token_id], name: "idx_verifications_token_id")
  @@index([created_at(sort: Desc)], name: "idx_verifications_created_at")
}
