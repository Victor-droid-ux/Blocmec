// prisma/schema/qr_codes.prisma
enum QrStatus {
  active
  inactive
  expired
}

model QrCode {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  user_id              String   @db.ObjectId
  token_id             String   @unique
  batch_id             String?  @db.ObjectId
  product_type         String
  product_name         String?
  qr_data              String
  qr_image_url         String?
  blockchain_tx_hash   String?
  blockchain_token_id  String?
  metadata             Json?
  status               QrStatus @default(active)
  scan_limit           Int      @default(0)
  scan_count           Int      @default(0)
  expires_at           DateTime?
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  user     User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  batch    Batch? @relation(fields: [batch_id], references: [id], onDelete: SetNull)
  verifications Verification[]

  @@index([user_id], name: "idx_qr_codes_user_id")
  @@index([batch_id], name: "idx_qr_codes_batch_id")
}
