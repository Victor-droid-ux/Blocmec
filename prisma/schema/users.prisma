// prisma/schema/users.prisma

enum UserRole {
  user
  admin
  developer
}

enum UserStatus {
  active
  inactive
  suspended
}

model User {
  id                  String      @id @default(auto()) @map("_id") @db.ObjectId
  email               String      @unique
  password_hash       String?
  name                String?
  username            String?     @unique
  phone               String?
  location            String?
  department          String?
  bio                 String?
  avatar_url          String?
  verification_domain String?
  allowed_categories  String[]    @default([])
  role                UserRole    @default(user)
  status              UserStatus  @default(active)
  api_credits         Int         @default(0)
  subscription_plan   String      @default("free")
  email_verified      Boolean     @default(false)
  verification_token  String?
  reset_token         String?
  reset_token_expires DateTime?
  created_at          DateTime    @default(now())
  updated_at          DateTime    @updatedAt

  qr_codes      QrCode[]
  batches       Batch[]
  transactions  Transaction[]
  api_keys      ApiKey[]
  audit_logs    AuditLog[]
  webhooks      WebhookEndpoint[]
  webhook_payloads WebhookEventPayload[]
  uploaded_files UserFile[]
  settings      UserSettings?
}