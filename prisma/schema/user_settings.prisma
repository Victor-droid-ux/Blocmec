model UserSettings {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                 String   @unique @db.Uuid
  company_name            String?  @db.VarChar(255)
  company_email           String?  @db.VarChar(255)
  company_website         String?  @db.VarChar(1024)
  company_address         String?
  timezone                String   @default("America/New_York") @db.VarChar(100)
  language                String   @default("en-US") @db.VarChar(20)
  date_format             String   @default("MM/DD/YYYY") @db.VarChar(20)
  email_notifications     Boolean  @default(true)
  sms_notifications       Boolean  @default(false)
  push_notifications      Boolean  @default(true)
  two_factor_auth         Boolean  @default(false)
  session_timeout_minutes Int      @default(30)
  api_access_enabled      Boolean  @default(true)
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], name: "idx_user_settings_user_id")
}